`include "piso.v"
module top;
   reg clk,rst,load;
   reg[3:0]pin;
   
   piso dut(clk,rst,pin,sout,load);

   initial begin
      clk=0;
	  forever #5 clk=~clk;
   end
   initial begin
       rst=1;
	   #20;
	   rst=0;
   end
      initial begin
	      wait(rst==0); //this statement wait upto 20ps 
          load=1;
		  pin=4'b1010;
          @(posedge clk);
          @(posedge clk);
		  load=0;
	  end
	   initial #200 $stop;
endmodule 
