module counter(clk,rst,y);
    input clk,rst;
	output y;
	reg [1:0] count_int; //internal count register

	always @(posedge clk)begin
	   if(rst) count_int<=0;
	   else count_int<=count_int+1;
	end
	assign y=count_int[1]& count_int[0];
endmodule 

module top;
   reg clk,rst;
   wire y;
   counter dut(clk,rst,y);
   initial begin
     clk=0;
	 forever #5 clk=~clk;
   end
   initial begin
      rst=1;
	  #20;
	  rst=0;
   end
   initial #300 $stop;
endmodule 

